+bool Presenter::EnsureBlendResources(const AbstractTexture* ref)
+{
+  if (!m_blend_vs)
+  {
+    m_blend_vs = g_gfx->CreateShaderFromSource(
+        ShaderStage::Vertex, FramebufferShaderGen::GenerateFrameBlendVertexShader(), nullptr,
+        "Frame blend vertex shader");
+    if (!m_blend_vs)
+      return false;
+  }
+  if (!m_blend_ps)
+  {
+    m_blend_ps = g_gfx->CreateShaderFromSource(
+        ShaderStage::Pixel, FramebufferShaderGen::GenerateFrameBlendPixelShader(), nullptr,
+        "Frame blend pixel shader");
+    if (!m_blend_ps)
+      return false;
+  }
+
+  const AbstractTextureFormat fmt = ref->GetFormat();
+  if (!m_blend_scratch_tex || m_blend_scratch_tex->GetWidth() != ref->GetWidth() ||
+      m_blend_scratch_tex->GetHeight() != ref->GetHeight() ||
+      m_blend_scratch_tex->GetFormat() != fmt)
+  {
+    m_blend_scratch_fb.reset();
+    const TextureConfig cfg(ref->GetWidth(), ref->GetHeight(), 1, 1, 1, fmt,
+                            AbstractTextureFlag_RenderTarget, AbstractTextureType::Texture_2DArray);
+    m_blend_scratch_tex = g_gfx->CreateTexture(cfg, "Frame blend scratch");
+    if (!m_blend_scratch_tex)
+      return false;
+    m_blend_scratch_fb = g_gfx->CreateFramebuffer(m_blend_scratch_tex.get(), nullptr);
+    if (!m_blend_scratch_fb)
+      return false;
+  }
+
+  if (!m_blend_pipeline || m_blend_pipeline_format != fmt)
+  {
+    AbstractPipelineConfig cfg = {};
+    cfg.vertex_shader = m_blend_vs.get();
+    cfg.geometry_shader = nullptr;
+    cfg.pixel_shader = m_blend_ps.get();
+    cfg.rasterization_state = RenderState::GetNoCullRasterizationState(PrimitiveType::Triangles);
+    cfg.depth_state = RenderState::GetNoDepthTestingDepthState();
+    cfg.blending_state = RenderState::GetNoBlendingBlendState();
+    cfg.framebuffer_state = RenderState::GetColorFramebufferState(fmt);
+    cfg.usage = AbstractPipelineUsage::Utility;
+    m_blend_pipeline = g_gfx->CreatePipeline(cfg);
+    if (!m_blend_pipeline)
+      return false;
+    m_blend_pipeline_format = fmt;
+  }
+  return true;
+}
+
+const AbstractTexture* Presenter::RenderBlendToScratch(float t)
+{
+  if (!m_xfb_entry || !m_xfb_entry->texture || !m_prev_xfb_entry || !m_prev_xfb_entry->texture)
+    return nullptr;
+
+  AbstractTexture* const cur = m_xfb_entry->texture.get();
+  if (!EnsureBlendResources(cur))
+    return nullptr;
+
+  g_gfx->SetFramebuffer(m_blend_scratch_fb.get());
+  g_gfx->SetViewportAndScissor(MathUtil::Rectangle<int>{
+      0, 0, static_cast<int>(m_blend_scratch_tex->GetWidth()),
+      static_cast<int>(m_blend_scratch_tex->GetHeight())});
+  g_gfx->SetPipeline(m_blend_pipeline.get());
+  g_gfx->SetTexture(0, m_prev_xfb_entry->texture.get());
+  g_gfx->SetTexture(1, cur);
+  g_gfx->SetSamplerState(0, RenderState::GetLinearSamplerState());
+  g_gfx->SetSamplerState(1, RenderState::GetLinearSamplerState());
+
+  const float uniforms[4] = {t, 0.0f, 0.0f, 0.0f};
+  g_vertex_manager->UploadUtilityUniforms(uniforms, sizeof(uniforms));
+  g_gfx->Draw(0, 3);
+
+  return m_blend_scratch_tex.get();
+}
