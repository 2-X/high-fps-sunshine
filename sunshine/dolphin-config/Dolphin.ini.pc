# Loose SyncGPU: keeps dual-core speed but adds cheap sync barriers so the GPU
# thread can't race ahead of the CPU thread — the high-fps FIFO stress trips a
# "GFX FIFO: Unknown Opcode" desync on some Windows clients without it (laptop,
# 2026-08-27). The wide distances make the barriers nearly free. Mirrors the
# Mac config (Dolphin.ini). If a weak GPU still desyncs, set CPUThread = False.
SyncGPU = True
SyncGpuMaxDistance = 1000000
SyncGpuMinDistance = -1000000
